+func TestConstructedStylesheetAuthoritativeProgramMutations(t *testing.T) {
+	b, err := New(v8engine.Factory{}, chrome152.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := b.NewContext()
+	defer c.Close()
+	p, err := c.NewPage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := p.Evaluate(context.Background(), `(()=>{
+const target=document.createElement('div');target.className='target';document.body.append(target);
+const sheet=new CSSStyleSheet();sheet.replaceSync('.target { color: red } @media (min-width: 1px) { .target { color: blue } }');
+document.adoptedStyleSheets=[sheet];
+const list=sheet.cssRules, first=list[0], style=first.style, media=list[1], nested=media.cssRules[0];
+const read=()=>getComputedStyle(target).color;
+if(read()!=='rgb(0, 0, 255)')return 'initial:'+read();
+style.setProperty('color','green');
+if(first!==list[0]||style!==first.style||nested!==media.cssRules[0])return 'identity';
+media.media.mediaText='(max-width: 0px)';
+if(read()!=='rgb(0, 128, 0)')return 'media:'+read();
+sheet.insertRule('.target { color: purple }',1);
+if(list[0]!==first||list[2]!==media||read()!=='rgb(128, 0, 128)')return 'insert:'+read();
+list[1].selectorText='.other';
+if(read()!=='rgb(0, 128, 0)')return 'selector:'+read();
+sheet.deleteRule(1);
+return list.length===2&&list[0]===first&&list[1]===media;
+})()`)
+	if err != nil || got != true {
+		t.Fatalf("authoritative stylesheet program: %v %v", got, err)
+	}
+}
