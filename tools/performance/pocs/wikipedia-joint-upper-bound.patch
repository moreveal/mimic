+// Diagnostic only: memoize Playwright InjectedScript selection across mutations.
+// This deliberately violates locator freshness and must never ship.
+func diagnosticQueryMemoDeclaration(declaration string) string {
+	return `(function(original) {
+  const slot = Symbol.for('mimic.diagnostic.playwrightQueryMemo');
+  let install = globalThis[slot];
+  if (!install) {
+    const stats = { calls: 0, inspected: 0, installed: 0, qs: 0, qsa: 0, hits: 0, misses: 0, seen: [], queries: [] };
+    const installed = new WeakSet();
+    const method = (object, name) => {
+      for (let current = object, depth = 0; current && depth < 5; depth++) {
+        const descriptor = Object.getOwnPropertyDescriptor(current, name);
+        if (descriptor) return typeof descriptor.value === 'function' ? descriptor.value : null;
+        current = Object.getPrototypeOf(current);
+      }
+      return null;
+    };
+    install = (candidate) => {
+      if (!candidate || typeof candidate !== 'object' || installed.has(candidate)) return;
+      stats.inspected++;
+      if (stats.seen.length < 24) {
+        const constructor = method(candidate, 'constructor');
+        const summary = (constructor && constructor.name || '?') + ':' + Object.getOwnPropertyNames(candidate).slice(0, 16).join(',');
+        if (!stats.seen.includes(summary)) stats.seen.push(summary);
+      }
+      const query = method(candidate, 'querySelector');
+      if (!query || !method(candidate, 'querySelectorAll') || !method(candidate, 'parseSelector')) return;
+      stats.installed++;
+      const queryAll = method(candidate, 'querySelectorAll');
+      const byRoot = new WeakMap();
+      const fifo = [];
+      const memoize = (name, originalQuery, all) => Object.defineProperty(candidate, name, {
+        configurable: true,
+        writable: true,
+        value: function(selector, root, strict) {
+          if (all) stats.qsa++;
+          else stats.qs++;
+          if (!root || (typeof root !== 'object' && typeof root !== 'function')) {
+            return Reflect.apply(originalQuery, this, arguments);
+          }
+          let key;
+          try {
+            key = JSON.stringify([name, selector, strict], (_name, value) => {
+              return value instanceof RegExp ? { regex: value.source, flags: value.flags } : value;
+            });
+          } catch {
+            return Reflect.apply(originalQuery, this, arguments);
+          }
+          if (key.length > 65536) return Reflect.apply(originalQuery, this, arguments);
+          if (stats.queries.length < 16 && !stats.queries.includes(key.slice(0, 256))) stats.queries.push(key.slice(0, 256));
+          let entries = byRoot.get(root);
+          if (entries && entries.has(key)) {
+            stats.hits++;
+            const retained = entries.get(key);
+            return all ? retained.slice() : retained;
+          }
+          stats.misses++;
+          const result = Reflect.apply(originalQuery, this, arguments);
+          if (result == null || (all && (!Array.isArray(result) || result.length === 0))) return result;
+          if (!entries) byRoot.set(root, (entries = new Map()));
+          entries.set(key, all ? result.slice() : result);
+          fifo.push({ root, key });
+          if (fifo.length > 64) {
+            const oldest = fifo.shift();
+            byRoot.get(oldest.root).delete(oldest.key);
+          }
+          return result;
+        }
+      });
+      memoize('querySelector', query, false);
+      memoize('querySelectorAll', queryAll, true);
+      installed.add(candidate);
+    };
+    install.stats = stats;
+    Object.defineProperty(globalThis, slot, { value: install, configurable: true });
+  }
+  return function(...args) {
+    install.stats.calls++;
+    install(this);
+    for (const argument of args) {
+      install(argument);
+      // Protocol utility wrappers can pack remote handles into an array.
+      if (Array.isArray(argument)) {
+        for (const handle of argument) install(handle);
+      }
+    }
+    const result = Reflect.apply(original, this, args);
+    // Also recognize the initial construction result without attaching to
+    // unrelated client objects or changing promise/task ordering.
+    install(result);
+    return result;
+  };
+})(
+` + declaration + `
+)`
