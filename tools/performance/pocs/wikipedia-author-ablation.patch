 	"strings"
@@ -451,6 +452,11 @@ func (r *Realm) evaluateClassicScript(ctx context.Context, source, name string,
 	previous := r.currentScript
 	r.currentScript = scriptID
 	defer func() { r.currentScript = previous }()
+	// Destructive diagnostic only: preserve script cleanup, but suppress all
+	// classic author execution and the mutations/observers it would schedule.
+	if os.Getenv("MIMIC_POC_NO_AUTHOR_SCRIPT") == "1" {
+		return r.checkpoint(ctx)
+	}
 	_, evalErr := r.Evaluate(ctx, source, name)
 	return errors.Join(evalErr, r.checkpoint(ctx))
 }
