+// SetTaskSuppressor is a diagnostic hook. Suppressed tasks retain queue
+// selection, transition accounting and the event-loop checkpoint, but their
+// callback body is skipped.
+func (s *Scheduler) SetTaskSuppressor(f func(Source) bool) {
+	s.mu.Lock()
+	s.taskSuppressor = f
+	s.mu.Unlock()
