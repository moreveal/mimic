+package browser
+
+import (
+	"context"
+	chrome152 "github.com/moreveal/mimic/chrome/152"
+	v8engine "github.com/moreveal/mimic/internal/engine/v8"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestSnapshotActualPage(t *testing.T) {
+	dir := os.Getenv("MIMIC_SNAPSHOT_PROOF_DIR")
+	if dir == "" {
+		t.Skip("opt-in snapshot Page proof")
+	}
+	read := func(name string) []byte {
+		t.Helper()
+		v, e := os.ReadFile(filepath.Join(dir, name))
+		if e != nil {
+			t.Fatal(e)
+		}
+		return v
+	}
+	b, e := New(v8engine.SnapshotFactory{Bytes: read("page-bootstrap.blob"), SurfaceSource: string(read("bootstrap-capture.js")), BootstrapCalls: string(read("bootstrap-capture.json"))}, chrome152.New())
+	if e != nil {
+		t.Fatal(e)
+	}
+	c := b.NewContext()
+	defer c.Close()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/html")
+		w.Write([]byte(`<!doctype html><html><head><title>Restored</title></head><body><div id="root">seed</div></body></html>`))
+	}))
+	defer server.Close()
+	for i := 0; i < 3; i++ {
+		p, e := c.NewPage()
+		if e != nil {
+			t.Fatal(e)
+		}
+		start := time.Now()
+		if e = p.Navigate(context.Background(), server.URL); e != nil {
+			t.Fatal(e)
+		}
+		t.Log("actual Page navigation", time.Since(start))
+		clock, e := p.Evaluate(context.Background(), `[performance.now(),performance.now(),performance.timeOrigin,Date.now()]`)
+		if e != nil {
+			t.Fatal(e)
+		}
+		t.Log("clocks", clock)
+		value, e := p.Top.Realm.runtime.Eval(context.Background(), `(()=>{const root=document.getElementById('root'),node=document.createElement('span');node.textContent='live';root.appendChild(node);return [document.title,root===document.getElementById('root'),root.textContent,window===top,window===parent].join(',')})()`, "snapshot:page-proof")
+		if e != nil {
+			t.Fatal(e)
+		}
+		if value.String() != "Restored,true,seedlive,true,true" {
+			t.Fatal(value.String())
+		}
+		if e = p.Close(); e != nil {
+			t.Fatal(e)
+		}
+	}
+}
