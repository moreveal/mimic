+// RestoreSurface is a guarded experimental Page integration. Mismatches fail
+// closed; automatic fallback/selection is deliberately not implemented yet.
+func (a *adapter) RestoreSurface(source string) (bool, error) {
+	if a.snapshotSource == "" {
+		return false, nil
+	}
+	if source != a.snapshotSource {
+		return false, fmt.Errorf("snapshot surface source mismatch")
+	}
+	if !json.Valid([]byte(a.snapshotCalls)) {
+		return false, fmt.Errorf("snapshot contract invalid")
+	}
+	_, err := a.Eval(context.Background(), `(()=>{const calls=`+a.snapshotCalls+`;for(const call of calls){
+ const name=call.name;if(['token','intlEnvironment','permissionsPolicy','ready','viewport','screen'].includes(name))continue;
+ const current=__mimic[name](...JSON.parse(call.args));
+ if(name==='windowRelations'){const previous=JSON.parse(call.result);for(const k of ['top','parent'])if((current[k]===current.self)!==(previous[k]===previous.self))throw Error('snapshot frame topology mismatch');if(current.top!==current.self||current.parent!==current.self)throw Error('snapshot remote frames unsupported');continue;}
+ if(JSON.stringify(current)!==call.result)throw Error('snapshot configuration mismatch: '+name);
+ }snapshotLiveHost=((live)=>(name,...args)=>live[name](...args))(__mimic);__mimicRestoreSurface(__mimic);delete globalThis.__mimicRestoreSurface;})()`, "mimic:snapshot-rebind")
+	return err == nil, err
+}
+
 // Transient arguments cannot escape the synchronous host call. A frame stays
 // checked out until the return value is marshalled, including nested JS calls.
 // Clearing it prevents closed scopes and host objects from becoming roots.
