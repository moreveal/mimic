--- /dev/null
+++ b/tools/performance/build_page_snapshot_test.go.txt
@@ -0,0 +1,214 @@
+package snapshotprobe
+
+import (
+	"context"
+	"fmt"
+	gov8 "github.com/maclof/gov8"
+	"github.com/moreveal/mimic/internal/engine"
+	v8engine "github.com/moreveal/mimic/internal/engine/v8"
+	"github.com/moreveal/mimic/internal/webapi"
+	"os"
+	"testing"
+	"time"
+)
+
+func TestRealBootstrapSnapshotRebind(t *testing.T) {
+	initialRuntime, initErr := v8engine.NewRuntime()
+	if initErr != nil {
+		t.Fatal(initErr)
+	}
+	if err := initialRuntime.Dispose(); err != nil {
+		t.Fatal(err)
+	}
+	source, err := os.ReadFile(".build/bootstrap-capture.js")
+	if err != nil {
+		t.Fatal(err)
+	}
+	calls, err := os.ReadFile(".build/bootstrap-capture.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	eval := func(ctx *gov8.Context, scope *gov8.Scope, source string) string {
+		t.Helper()
+		script, e := ctx.Compile(scope, source, nil)
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer script.Close()
+		value, e := script.Run(scope, nil)
+		if e != nil {
+			t.Fatal(e)
+		}
+		result, e := value.ToString(ctx)
+		if e != nil {
+			t.Fatal(e)
+		}
+		return result
+	}
+	creator, err := gov8.NewSnapshotCreator()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, err := creator.Isolate().NewContext()
+	if err != nil {
+		t.Fatal(err)
+	}
+	scope, err := creator.Isolate().NewScope()
+	if err != nil {
+		t.Fatal(err)
+	}
+	eval(ctx, scope, `let snapshotReplies=`+string(calls)+`;let snapshotIndex=0,snapshotLiveHost=null;globalThis.__mimic=new Proxy({}, {get(target,name){return (...args)=>{if(snapshotLiveHost)return snapshotLiveHost(name,...args);const next=snapshotReplies[snapshotIndex++];if(!next||next.name!==name||next.args!==JSON.stringify(args))throw Error('replay mismatch '+name+' at '+(snapshotIndex-1));return next.result===undefined?undefined:JSON.parse(next.result)}}});void 0;`)
+	start := time.Now()
+	prepared, err := webapi.SnapshotSurface(string(source))
+	if err != nil {
+		t.Fatal(err)
+	}
+	eval(ctx, scope, prepared)
+	t.Log("replayed bootstrap", time.Since(start))
+	t.Log("calls replayed", eval(ctx, scope, `snapshotIndex`))
+	eval(ctx, scope, `snapshotReplies=null;delete globalThis.WebAssembly;void 0`)
+	if err := creator.SetDefaultContext(ctx); err != nil {
+		t.Fatal(err)
+	}
+	scope.Close()
+	ctx.Close()
+	start = time.Now()
+	blob, err := creator.CreateBlob(gov8.FunctionCodeKeep)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer blob.Release()
+	if err := os.WriteFile(".build/page-bootstrap.blob", blob.Bytes(), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Log("snapshot creation", time.Since(start), "bytes", len(blob.Bytes()))
+	for i := 0; i < 2; i++ {
+		adapter := (v8engine.SnapshotFactory{Bytes: blob.Bytes()}).New()
+		if err := adapter.Set("__adapterProbe", adapter.Function(func(_ engine.Value, _ []engine.Value) (engine.Value, error) { return adapter.Value(i), nil })); err != nil {
+			t.Fatal(err)
+		}
+		value, err := adapter.Eval(context.Background(), `[typeof Document,typeof Element,__adapterProbe()].join(',')`, "snapshot:adapter-proof")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if want := fmt.Sprintf("function,function,%d", i); value.String() != want {
+			t.Fatalf("adapter %s want %s", value.String(), want)
+		}
+		promise := adapter.NewPromise()
+		if err := promise.Resolve("restored"); err != nil {
+			t.Fatal(err)
+		}
+		resolved, done, err := adapter.Await(promise.Value)
+		if err != nil || !done || resolved.String() != "restored" {
+			t.Fatalf("promise %v %v %v", resolved, done, err)
+		}
+		if err := adapter.Close(); err != nil {
+			t.Fatal(err)
+		}
+		t.Log("actual engine adapter restored, native callback and Promise passed", i)
+	}
+	for i := 0; i < 3; i++ {
+		start = time.Now()
+		iso, e := gov8.NewIsolateFromSnapshot(blob)
+		if e != nil {
+			t.Fatal(e)
+		}
+		ctx, e := iso.NewContext()
+		if e != nil {
+			t.Fatal(e)
+		}
+		scope, e := iso.NewScope()
+		if e != nil {
+			t.Fatal(e)
+		}
+		t.Log("restore isolate+context", time.Since(start))
+		t.Log("wasm", eval(ctx, scope, `typeof WebAssembly+":"+(typeof WebAssembly!=="undefined"?typeof WebAssembly.instantiate:"missing")`))
+		state := map[string]string{}
+		invocations := 0
+		readyCalls := 0
+		fn, e := iso.NewFunction(scope, ctx, func(cs *gov8.CallbackScope, args gov8.FunctionCallbackArguments, rv gov8.ReturnValue) {
+			invocations++
+			argv := make([]string, args.Length())
+			for j := range argv {
+				v, err := args.Get(j)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				argv[j], err = cs.ToString(v)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+			}
+			switch argv[0] {
+			case "apiAccess":
+			case "ready":
+				readyCalls++
+			case "storageGet":
+				value, ok := state[argv[1]+":"+argv[2]]
+				if !ok {
+					rv.SetNull()
+					return
+				}
+				v, err := cs.NewString(value)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				rv.Set(v)
+			case "storageSet":
+				state[argv[1]+":"+argv[2]] = argv[3]
+			default:
+				t.Errorf("unexpected live call %v", argv)
+			}
+		}, nil)
+		if e != nil {
+			t.Fatal(e)
+		}
+		global, e := ctx.GlobalObject(scope)
+		if e != nil {
+			t.Fatal(e)
+		}
+		ok, e := global.SetByName(scope, ctx, "__snapshotBind", fn.Value)
+		if e != nil || !ok {
+			t.Fatalf("bind: %v %v", ok, e)
+		}
+		eval(ctx, scope, `snapshotLiveHost=__snapshotBind;delete globalThis.__snapshotBind;void 0`)
+		zone := "UTC"
+		locale := "en-US"
+		header := "geolocation=()"
+		if i == 1 {
+			zone = "Asia/Tokyo"
+			locale = "ja-JP"
+			header = "geolocation=*"
+		}
+		rebound := eval(ctx, scope, fmt.Sprintf(`(()=>{try{const policyBefore=document.featurePolicy;const liveHost=new Proxy({token:()=> 'new-token-%d',viewport:()=>({width:800,height:600,outerWidth:800,outerHeight:600}),screen:()=>({devicePixelRatio:1}),intlEnvironment:()=>({locale:%q,timeZone:%q}),permissionsPolicy:()=>({header:%q,origin:'https://fresh.example'})},{get(target,key){return target[key]||((...args)=>snapshotLiveHost(key,...args))}});__mimicRestoreSurface(liveHost);delete globalThis.__mimicRestoreSurface;return [policyBefore===document.featurePolicy,document.featurePolicy.allowsFeature('geolocation'),new Intl.DateTimeFormat().resolvedOptions().timeZone,new Intl.DateTimeFormat().resolvedOptions().locale,typeof __mimicRestoreSurface].join(',')}catch(e){return String(e.stack)}})()`, i, locale, zone, header))
+		allowed := "false"
+		if i == 1 {
+			allowed = "true"
+		}
+		if want := "true," + allowed + "," + zone + "," + locale + ",undefined"; rebound != want {
+			t.Fatalf("rebound got %s want %s", rebound, want)
+		}
+		if readyCalls != 1 {
+			t.Fatalf("ready calls %d", readyCalls)
+		}
+		t.Log("rebound state", rebound)
+		gotStorage := eval(ctx, scope, fmt.Sprintf(`const initial=localStorage.getItem('probe');localStorage.setItem('probe','page-%d');[initial===null,localStorage.getItem('probe'),sessionStorage.getItem('probe')===null,typeof __snapshotBind].join(',')`, i))
+		if want := fmt.Sprintf("true,page-%d,true,undefined", i); gotStorage != want {
+			t.Fatalf("storage got %s want %s", gotStorage, want)
+		}
+		if invocations < 4 {
+			t.Fatalf("missing live calls: %d", invocations)
+		}
+		t.Log("live host calls", invocations, "isolated storage", state)
+		got := eval(ctx, scope, `[typeof Document,typeof Element,typeof document,document===document,Array.prototype.map.call([1,2],x=>x*2).join(':')].join(',')`)
+		if got != "function,function,object,true,2:4" {
+			t.Fatal(got)
+		}
+		scope.Close()
+		ctx.Close()
+		iso.Close()
+	}
+}
