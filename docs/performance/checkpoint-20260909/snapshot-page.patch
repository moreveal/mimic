+package browser
+
+import (
+	"context"
+	chrome152 "github.com/moreveal/mimic/chrome/152"
+	v8engine "github.com/moreveal/mimic/internal/engine/v8"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestSnapshotReactProof(t *testing.T) {
+	dir := os.Getenv("MIMIC_SNAPSHOT_PROOF_DIR")
+	if dir == "" {
+		t.Skip("opt-in")
+	}
+	read := func(name string) []byte {
+		v, e := os.ReadFile(filepath.Join(dir, name))
+		if e != nil {
+			t.Fatal(e)
+		}
+		return v
+	}
+	b, e := New(v8engine.SnapshotFactory{Bytes: read("page-bootstrap.blob"), SurfaceSource: string(read("bootstrap-capture.js")), BootstrapCalls: string(read("bootstrap-capture.json"))}, chrome152.New())
+	if e != nil {
+		t.Fatal(e)
+	}
+	c := b.NewContext()
+	defer c.Close()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/" {
+			data, e := os.ReadFile(filepath.Join("../../benchmark/fixtures/vendor", filepath.Base(r.URL.Path)))
+			if e != nil {
+				http.NotFound(w, r)
+				return
+			}
+			w.Header().Set("Content-Type", "text/javascript")
+			w.Write(data)
+			return
+		}
+		w.Header().Set("Content-Type", "text/html")
+		w.Write([]byte(`<!doctype html><html><head><script src="/react.production.min.js"></script><script src="/react-dom.production.min.js"></script></head><body><div id="root"></div></body></html>`))
+	}))
+	defer server.Close()
+	p, e := c.NewPage()
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer p.Close()
+	if e = p.Navigate(context.Background(), server.URL); e != nil {
+		t.Fatal(e)
+	}
+	if _, e = p.Evaluate(context.Background(), `ReactDOM.createRoot(document.getElementById('root')).render(React.createElement('b',null,'react'))`); e != nil {
+		t.Fatal(e)
+	}
+	for i := 0; i < 5; i++ {
+		value, e := p.Evaluate(context.Background(), `(()=>{const s=React.__SECRET_INTERNALS_DO_NOT_USE_OR_YOU_WILL_BE_FIRED.Scheduler;return {text:document.getElementById('root').textContent,now:s.unstable_now(),yield:s.unstable_shouldYield(),task:s.unstable_getFirstCallbackNode()}})()`)
+		if e != nil {
+			t.Fatal(e)
+		}
+		t.Log(value)
+		if m, ok := value.(map[string]any); ok && m["text"] == "react" {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("React did not render")
+}
